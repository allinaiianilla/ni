#!/bin/sh

case "$1" in
    post)
        echo "wifi restart ..."
        systemctl stop NetworkManager
        systemctl stop wpa_supplicant
        modprobe -r brcmfmac_wcc 2>/dev/null || true
        modprobe -r brcmfmac 2>/dev/null || true
        modprobe -r brcmutil 2>/dev/null || true
        sleep 1
        modprobe brcmfmac
        systemctl start NetworkManager
        sleep 3
        ;;
esac

